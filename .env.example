# Supabase 資料庫連線字串 (請替換為你自己的帳號密碼)
DATABASE_URL="postgresql://[使用者帳號]:[你的密碼]@[主機網址]:5432/postgres"

# 允許呼叫後端的前端來源，使用逗號分隔；Render 正式環境請設定實際 Vercel 網域。
CORS_ALLOWED_ORIGINS="http://localhost:5173,https://gofin-tracker-flame.vercel.app"

# AI 日報產生服務（僅設定於後端與 Render，不可放入前端）
GEMINI_API_KEY="[你的 Gemini API Key]"
GEMINI_MODEL="gemini-3.6-flash"
GDELT_BASE_URL="https://api.gdeltproject.org/api/v2/doc/doc"
DAILY_REPORT_API_TOKEN="[供排程呼叫使用的長隨機 Token]"
